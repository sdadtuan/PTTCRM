NEXT_PUBLIC_GTM_API_BASE=http://localhost:3001
# CMS lives in this Next app (file store + /cms desk). Do not point this at another product.
NEXT_PUBLIC_CMS_API_BASE=
CMS_ADMIN_SECRET=dev-cms
PTTCRM_CMS_DIR=
NEXT_PUBLIC_LOGIN_URL=https://rs.pttads.vn/login
# After PO/IT CNAME cutover: NEXT_PUBLIC_LOGIN_URL=https://app.pttcrm.com/login
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_USD_PRICE=0
# Set to 1 on staging/prod EN USD list (W2): shows §6.3 USD on /en/pricing
# W4: /en/status polls GET {NEXT_PUBLIC_GTM_API_BASE}/api/v1/public/gtm/status
# W4B: /en/trust/enterprise polls GET .../enterprise-readiness (SSO/RBAC posture)
# W4D: staff SSO/MFA — see docs/runbooks/staff-sso-mfa-deploy.md
CMS_REVALIDATE_SECRET=dev-secret
